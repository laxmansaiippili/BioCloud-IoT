# =============================================================================
# BioCloud IoT — Smart Healthcare Monitoring
# Environment Variables Reference (.env.example)
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="BioCloud IoT - Smart Healthcare Monitoring"
APP_ENV=development          # development | production
APP_PORT=3000
APP_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_64_CHAR_HEX

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL / SMTP (for real email verification & notifications)
# Currently simulated in the demo — fill these to enable real email delivery.
# Supported providers: Gmail SMTP, SendGrid, Mailgun, AWS SES, etc.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465 (SSL), false for 587 (TLS)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password  # Use App Passwords for Gmail — never your real password

# Sender identity shown in emails
MAIL_FROM_NAME="BioCloud Hospital System"
MAIL_FROM_ADDRESS=noreply@yourhospital.com

# SendGrid alternative (leave blank if using SMTP)
SENDGRID_API_KEY=

# Mailgun alternative (leave blank if using SMTP)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# SESSION / TOKEN
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_HEX
SESSION_TTL_HOURS=8
VERIFICATION_TOKEN_TTL_MINUTES=15
RESET_TOKEN_TTL_HOURS=1

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=5    # Max login/register/reset attempts per window

# ─────────────────────────────────────────────────────────────────────────────
# DEFAULT ADMIN ACCOUNT (created automatically on first run)
# CHANGE IMMEDIATELY after first login in production.
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@hospital.org
DEFAULT_ADMIN_PASSWORD=Admin@123!
DEFAULT_ADMIN_NAME="Hospital Administrator"

# ─────────────────────────────────────────────────────────────────────────────
# IoT / MQTT (optional — for real hardware integration)
# ─────────────────────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=biocloud-server

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# Whether to send real email notifications (requires SMTP config above)
ENABLE_EMAIL_NOTIFICATIONS=false

# Whether to enable in-app (push) notifications
ENABLE_PUSH_NOTIFICATIONS=false

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourhospital.com
